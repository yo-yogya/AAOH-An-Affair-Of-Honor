# This .gitignore file is configured for Unity projects.
# Ignore Unity temporary/generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when on exclude from project mode
/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / VS Code cache & build outputs
.vs/
.gradle/
ExportedObj/
.consulo/
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Root autogenerated solution & project files (Unity creates these at root)
/*.sln
/*.csproj
/*.unityproj

# Keep custom projects like VerificationTests
!VerificationTests/*.csproj

# Build output directories
bin/
obj/
VerificationTests/bin/
VerificationTests/obj/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
venv/
ENV/
